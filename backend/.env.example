# SmartRoad AI — Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1

# Database Configuration (SQLite default; can be switched to PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./smartroad.db

# CORS Configuration — Comma-separated allowed origins for local Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# YOLO Inference Engine Configuration
# Set to path of your trained weights file (relative to project root or absolute)
# Example: backend/weights/best.pt
# Leave empty to run in demo mode (model_not_configured response)
YOLO_MODEL_PATH=backend/weights/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.70

# Security / Administrative Operations (Development mode API secret or token)
ADMIN_API_KEY=dev_admin_secret_key_change_in_production
